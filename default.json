{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared base for OpenBunny repositories.",
  "extends": ["config:recommended", ":semanticCommits"],
  "dependencyDashboard": false,
  "timezone": "UTC",
  "schedule": ["before 6am"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "branchConcurrentLimit": 0,
  "labels": ["type/chore"],
  "rangeStrategy": "pin",
  "lockFileMaintenance": { "enabled": true },
  "vulnerabilityAlerts": { "labels": ["type/security"], "schedule": [] },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*[\\w-]+:\\s*['\"]?(?<currentValue>[^'\"\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^justfile$/"],
      "matchStrings": [
        "ghcr\\.io/renovatebot/renovate:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/renovatebot/renovate"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "automerge": true
    },
    {
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    { "matchUpdateTypes": ["major"], "automerge": false }
  ]
}
